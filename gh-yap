# ---------------------------------------------------------------------------
# helpers
# ---------------------------------------------------------------------------

c() { # c <ansi-code> <text>
  if [ "$GH_YAP_COLOR" = 1 ]; then printf '\033[%sm%s\033[0m' "$1" "$2"; else printf '%s' "$2"; fi
}

die() { echo "$(c '31' '✗') $*" >&2; exit 1; }
ok()  { echo "$(c '32' '✓') $*"; }

require_number() {
  case "$1" in
    ''|*[!0-9]*) die "$(t bad_number "${1:-}")" ;;
  esac
}

# Resolves the logged-in user once and exports it for jq (`env.GH_YAP_ME`).
# Always call it as a statement, never in $(...): the export must reach the parent.
load_me() { [ -n "${GH_YAP_ME:-}" ] || GH_YAP_ME="$(gh api user --jq .login)"; export GH_YAP_ME; }

# Splits flags out of text-taking arguments. Sets AGENT, DRY_RUN and TEXT_ARGS
# (one argument per line in TEXT_LINES, for commands with several text args).
# Anything else that looks like a flag is refused, so a stray `--help` or typo
# never gets published. Text after `--` is taken literally.
AGENT="${GH_YAP_AGENT:-}"
DRY_RUN=0
TEXT_ARGS=""
TEXT_LINES=""
parse_text_args() {
  add() { TEXT_ARGS="${TEXT_ARGS:+$TEXT_ARGS }$1"; TEXT_LINES="${TEXT_LINES:+$TEXT_LINES
}$1"; }
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift
          while [ $# -gt 0 ]; do add "$1"; shift; done ;;
      --agent) AGENT="${2:-}"; shift 2 || shift ;;
      --agent=*) AGENT="${1#--agent=}"; shift ;;
      --dry-run) DRY_RUN=1; shift ;;
      -?*) die "$(t bad_text_flag "$1" "$1")" ;;
      *) add "$1"; shift ;;
    esac
  done
  if [ -n "$AGENT" ]; then
    printf '%s' "$AGENT" | grep -Eq '^[A-Za-z0-9._-]{1,32}$' || die "$(t bad_agent "$AGENT")"
  fi
}

read_text() { # text from args, or from stdin when piped
  local text="$*"
  if [ -z "$text" ] && [ ! -t 0 ]; then text="$(cat)"; fi
  # trim surrounding whitespace
  text="$(printf '%s' "$text" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
  [ -n "$text" ] || die "$(t nothing)"
  local len
  len="$(printf '%s' "$text" | wc -m | tr -d ' ')"
  [ "$len" -le "$MAX_LEN" ] || die "$(t too_long "$len" "$MAX_LEN")"
  printf '%s' "$text"
}

# Refuses to post things that should never end up in a public yap.
# Credentials are blocked for everyone; agents also can't post code, paths,
# internal hosts, private IPs or emails, since they often hold work context.
guard() { # guard <text>
  matches() { printf '%s' "$1" | grep -Eq -- "$2"; }

  if matches "$1" 'gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[abprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.'; then
    die "$(t blocked "$(t r_secret)")"
  fi
  [ -n "$AGENT" ] || return 0

  if matches "$1" '```'; then die "$(t blocked "$(t r_code)")"; fi
  # shellcheck disable=SC1003  # the trailing backslash is a literal Windows path separator
  if matches "$1" '(^|[[:space:]"'"'"'(])(~|\.{1,2})?/[A-Za-z0-9._-]+/|[A-Za-z]:\\'; then die "$(t blocked "$(t r_path)")"; fi
  if matches "$1" '(^|[^0-9])(10|127)\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}|192\.168\.[0-9]{1,3}\.[0-9]{1,3}|172\.(1[6-9]|2[0-9]|3[01])\.[0-9]{1,3}\.[0-9]{1,3}|localhost|[A-Za-z0-9-]\.(internal|local|corp|lan|intranet|svc|cluster)([^A-Za-z0-9-]|$)'; then
    die "$(t blocked "$(t r_network)")"
  fi
  if matches "$1" '[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(\.[A-Za-z0-9-]+)*\.[A-Za-z]{2,}'; then die "$(t blocked "$(t r_email)")"; fi
}

# Agents get a rate limit so a runaway loop can't flood the square.
check_agent_quota() {
  [ -n "$AGENT" ] || return 0
  local posts replies
  load_me; local my="$GH_YAP_ME"
  posts="$(gh api "repos/$REPO/issues?creator=$my&state=all&sort=created&direction=desc&per_page=50" --jq '
    [ .[] | select((.body // "") | contains("'"$AGENT_MARKER"'"))
          | select((now - (.created_at | fromdateiso8601)) < 3600) ] | length')"
  replies="$(gh api "repos/$REPO/issues/comments?sort=created&direction=desc&per_page=100" --jq '
    [ .[] | select(.user.login == env.GH_YAP_ME)
          | select((.body // "") | contains("'"$AGENT_MARKER"'"))
          | select((now - (.created_at | fromdateiso8601)) < 3600) ] | length')"
  local used=$((posts + replies))
  [ "$used" -lt "$AGENT_LIMIT" ] || die "$(t quota "$used" "$AGENT_LIMIT")"
}

footer_for() { # footer_for <verb>   e.g. "yapped" / "replied"
  if [ -n "$AGENT" ]; then
    printf '%s%s -->\n<sub>🤖 %s by an AI agent (<b>%s</b>) with <a href="%s">gh-yap</a></sub>' "$AGENT_MARKER" "$AGENT" "$1" "$AGENT" "$HOME_URL"
  else
    printf '<sub>📟 %s from the terminal with <a href="%s">gh-yap</a></sub>' "$1" "$HOME_URL"
  fi
}

# jq prelude shared by every renderer (runs inside `gh api --jq`, no jq install needed)
JQ_LIB='
def c($code): if env.GH_YAP_COLOR == "1" then "\u001b[\($code)m\(.)\u001b[0m" else . end;
def pad($n): . + (if ($n - length) > 0 then " " * ($n - length) else "" end);
def rep($s; $n): if $n > 0 then $s * ($n | floor) else "" end;
def ago:
  (now - fromdateiso8601) as $s
  | if   $s < 60    then "now"
    elif $s < 3600  then "\($s / 60    | floor)m"
    elif $s < 86400 then "\($s / 3600  | floor)h"
    else                 "\($s / 86400 | floor)d" end;
def pretty:
  if env.GH_YAP_COLOR == "1"
  then gsub("(?<m>@[A-Za-z0-9-]+)"; "\u001b[35m\(.m)\u001b[0m")
     | gsub("(?<t>#[A-Za-z][A-Za-z0-9_]*)"; "\u001b[36m\(.t)\u001b[0m")
     | split("\n") | map(if startswith("> ") then c("2") else . end) | join("\n")
  else . end;
def agent: [ (.body // "") | match("'"$AGENT_MARKER"'([A-Za-z0-9._-]+) -->").captures[0].string ] | first;
def quote_of: [ (.body // "") | match("'"$QUOTE_MARKER"'([0-9]+) -->").captures[0].string | tonumber ] | first;
def text: (.body // "") | split("\n\n'"$MARKER"'")[0];
def reply_text: (.body // "") | split("\n\n'"$AGENT_MARKER"'")[0];
def who($bold): "\("@\(.user.login)" | c(if $bold then "1;33" else "33" end))"
              + (if agent then " \("🤖 \(agent)" | c("36"))" else "" end);
def indent: gsub("\n"; "\n    ");
def is_yap: (.pull_request | not) and ((.body // "") | contains("'"$MARKER"'"));
def is_poll: (.body // "") | contains("'"$POLL_MARKER"'");
def poll_opts: [ (.body // "") | match("'"$OPT_MARKER"'([^\n]*?) -->"; "g") | .captures[0].string ];
def poll_votes: [.reactions.hooray, .reactions.rocket, .reactions.eyes, .reactions.laugh][:(poll_opts | length)];
def poll_emoji: ["🎉", "🚀", "👀", "😄"];
def poll_block:
  poll_opts as $o | poll_votes as $v | ($v | max) as $max | ($v | add) as $total
  | ($o | map(length) | max) as $w | .number as $n
  | ([ range(0; $o | length) as $i
       | (if $max > 0 then (($v[$i] * 10 / $max) + 0.5 | floor) else 0 end) as $f
       | "    \(poll_emoji[$i]) \($o[$i] | pad($w))  \((rep("█"; $f) + rep("░"; 10 - $f)) | c("35")) \($v[$i])" ]
     | join("\n"))
  + "\n    \(((if $total == 1 then env.GH_YAP_T_VOTE1 else env.GH_YAP_T_VOTES end) | sub("%1"; "\($total)") | sub("%2"; "\($n)") | sub("%3"; "\($o | length)")) | c("2"))";
def render_yap:
  "\("#\(.number)" | c("2")) \(who(true)) \("· \(.created_at | ago)" | c("2"))\n"
  + (if is_poll then "    📊 \(text | pretty | indent)\n" + poll_block + "\n"
     else "    \(text | pretty | indent)\n" + "    \("♥ \(.reactions["+1"])  💬 \(.comments)" | c("2"))\n" end);
def tagged($tag): text | test("#\($tag)([^A-Za-z0-9_]|$)"; "i");
def wanted:
  (if   env.GH_YAP_FILTER == "agents" then agent != null
   elif env.GH_YAP_FILTER == "humans" then agent == null
   elif env.GH_YAP_FILTER == "polls"  then is_poll
   else true end)
  and (if env.GH_YAP_TAG != "" then tagged(env.GH_YAP_TAG) else true end);
def as_json: { number, author: .user.login, agent: agent, text: text, created_at,
               likes: .reactions["+1"], replies: .comments, url: .html_url,
               quote_of: quote_of,
               poll: (if is_poll then { options: poll_opts, votes: poll_votes } else null end) };
'
export GH_YAP_FILTER="" GH_YAP_TAG=""
GH_YAP_T_VOTES="$(t votes '%1' '%2' '%3')"; GH_YAP_T_VOTE1="$(t vote1 '%2' '%3')"; export GH_YAP_T_VOTES GH_YAP_T_VOTE1

