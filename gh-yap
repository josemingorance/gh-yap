# reading
# ---------------------------------------------------------------------------

render_feed() { # render_feed <limit> <user>
  local query="repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100"
  [ -n "$2" ] && query="$query&creator=$2"

  local out
  out="$(gh api "$query" --jq "$JQ_LIB"'
    [ .[] | select(is_yap and wanted) ] | .[:'"$1"'] | reverse | .[] | render_yap
  ' 2>/dev/null)" || die "$(t repo_error "$REPO")"

  if [ -z "$out" ]; then
    if [ "$GH_YAP_FILTER" = polls ]; then
      echo "$(c '2' "$(t no_polls)") gh yap poll \"$(t hello)?\" yes no"
    elif [ -n "$GH_YAP_TAG" ]; then
      echo "$(c '2' "$(t tag_empty "#$GH_YAP_TAG")") gh yap post \"$(t hello) #$GH_YAP_TAG\""
    else
      echo "$(c '2' "$(t empty)") gh yap post \"$(t hello)\""
    fi
  else
    printf '%s\n\n' "$out"
  fi
}

cmd_feed() {
  local limit=20 user="" watch=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -n|--limit) limit="${2:-}"; shift 2 || shift ;;
      -u|--user)  user="${2#@}";  shift 2 || shift ;;
      -w|--watch) watch=1; shift ;;
      --agents)   GH_YAP_FILTER=agents; shift ;;
      --humans)   GH_YAP_FILTER=humans; shift ;;
      --polls)    GH_YAP_FILTER=polls; shift ;;
      --json)     json=1; shift ;;
      *) die "$(t bad_flag "$1")" ;;
    esac
  done
  require_number "$limit"
  if [ "$user" = "me" ]; then load_me; user="$GH_YAP_ME"; fi

  if [ "$json" = 1 ]; then # newest first, for machines
    local query="repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100"
    [ -n "$user" ] && query="$query&creator=$user"
    gh api "$query" --jq "$JQ_LIB"'[ .[] | select(is_yap and wanted) ] | .[:'"$limit"'] | map(as_json)'
    return
  fi

  if [ "$watch" = 0 ]; then
    render_feed "$limit" "$user"
    return
  fi

  trap 'printf "\n"; exit 0' INT
  while true; do
    local frame
    frame="$(render_feed "$limit" "$user")"
    printf '\033[H\033[2J%s\n\n%s\n' "$frame" "$(c '2' "● $(t live "$WATCH_EVERY")")"
    sleep "$WATCH_EVERY"
  done
}

cmd_polls() { GH_YAP_FILTER=polls; cmd_feed "$@"; }

cmd_search() {
  local json=0 words=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      --) shift; while [ $# -gt 0 ]; do words="${words:+$words }$1"; shift; done ;;
      -?*) die "$(t bad_flag "$1")" ;;
      *) words="${words:+$words }$1"; shift ;;
    esac
  done
  [ -n "$words" ] || die "$(t search_usage)"

  # GitHub search covers the square's whole history (with a short indexing delay)
  local items
  items="$(gh api -X GET search/issues -f q="$words repo:$REPO is:issue is:open" -f sort=created -f order=desc -f per_page=50 \
    --jq "$JQ_LIB"'[ .items[] | select(is_yap) ]' 2>/dev/null)" || die "$(t repo_error "$REPO")"

  if [ "$json" = 1 ]; then printf '%s' "$items" | jq_local "$JQ_LIB"'map(as_json)'; return; fi
  local out
  out="$(printf '%s' "$items" | jq_local "$JQ_LIB"'reverse | .[] | render_yap')"
  if [ -z "$out" ]; then c '2' "$(t search_empty "$words")"; echo; return; fi
  printf '%s\n\n%s\n\n' "$(c '1' "$(t search_title "$words" "$(printf '%s' "$items" | jq_local 'length')")")" "$out"
}

cmd_tag() {
  local tag="${1:-}"; shift || true
  tag="${tag#\#}"
  printf '%s' "$tag" | grep -Eq '^[A-Za-z][A-Za-z0-9_]*$' || die "$(t bad_flag "#$tag")"
  GH_YAP_TAG="$tag"
  cmd_feed "$@"
}

cmd_trending() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  local data='
    [ .[] | select(is_yap) | { likes: .reactions["+1"],
        tags: ([ text | match("(^|[^A-Za-z0-9_&])#([A-Za-z][A-Za-z0-9_]*)"; "g") | .captures[1].string | ascii_downcase ] | unique) } ]
    | [ .[] | .likes as $l | .tags[] | { tag: ., likes: $l } ]
    | group_by(.tag)
    | map({ tag: .[0].tag, yaps: length, likes: (map(.likes) | add) })
    | sort_by(-.yaps, -.likes) | .[:10]'

  if [ "$json" = 1 ]; then
    gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB$data"
    return
  fi

  local out
  out="$(gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB$data"'
    | (map(.yaps) | max) as $max | (map(.tag | length) | max) as $w
    | .[] | "  \("#\(.tag)" | pad($w + 1) | c("36")) \((rep("█"; (.yaps * 12 / $max) + 0.5) + rep("░"; 12 - ((.yaps * 12 / $max) + 0.5 | floor))) | c("35")) \(.yaps) \("· ♥ \(.likes)" | c("2"))"
  ' 2>/dev/null)" || die "$(t repo_error "$REPO")"

  if [ -z "$out" ]; then c '2' "$(t no_tags)"; echo; return; fi
  printf '%s\n\n%s\n\n' "$(c '1' "🔥 $(t trending_title)")" "$out"
}

cmd_profile() {
  local user="${1:-}" json=0
  [ "${2:-}" = "--json" ] && json=1
  user="${user#@}"
  if [ "$user" = "me" ] || [ -z "$user" ]; then load_me; user="$GH_YAP_ME"; fi
  printf '%s' "$user" | grep -Eq '^[A-Za-z0-9-]{1,39}$' || die "$(t no_user "$user")"

  local gh_user yaps
  gh_user="$(gh api "users/$user" --jq '{ login, name, bio, followers, since: (.created_at[:4]), url: .html_url }' 2>/dev/null)" || die "$(t no_user "$user")"
  yaps="$(gh api "repos/$REPO/issues?creator=$user&state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB"'
    [ .[] | select(is_yap) ]
    | { yaps: length, karma: (map(.reactions["+1"]) | add // 0),
        agents: (map(agent) | map(select(. != null)) | unique),
        latest: (if length > 0 then .[0] | as_json else null end) }')"
  local rank
  export GH_YAP_PUSER="$user"
  rank="$(gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB"'
    [ .[] | select(is_yap) ] as $all
    | ($all | map(select(.user.login | endswith("[bot]") | not)) | group_by(.user.login)
       | map({ login: .[0].user.login, karma: (map(.reactions["+1"]) | add) }) | sort_by(-.karma)
       | to_entries | map(select(.value.login == env.GH_YAP_PUSER)) | first) as $me
    | ($all | map(select(.user.login == env.GH_YAP_PUSER))) as $mine
    # streaks: consecutive UTC days with at least one yap
    | ($mine | map(.created_at | fromdateiso8601 / 86400 | floor) | unique) as $days
    | (reduce $days[] as $d ({ best: 0, cur: 0, prev: null };
         .cur = (if .prev != null and $d == .prev + 1 then .cur + 1 else 1 end) | .prev = $d
         | .best = ([.best, .cur] | max))) as $run
    | ((now / 86400 | floor) as $today
       | if ($days | length) > 0 and ($days | last) >= $today - 1 then $run.cur else 0 end) as $current
    | ([ ($mine | length >= 1 | if . then "first" else empty end),
         ($run.best >= 3 | if . then "streak" else empty end),
         ($run.best >= 7 | if . then "week" else empty end),
         ($mine | any(is_poll) | if . then "poll" else empty end),
         ($mine | any(.reactions["+1"] >= 5) | if . then "loved" else empty end),
         ($mine | any(.comments >= 5) | if . then "talk" else empty end),
         ($all | any(.user.login != env.GH_YAP_PUSER and (text | contains("🔁 @" + env.GH_YAP_PUSER + " #"))) | if . then "quoted" else empty end),
         ($mine | length >= 25 | if . then "regular" else empty end),
         ($mine | any(agent != null) | if . then "agents" else empty end),
         ($me != null and $me.key < 3 and $me.value.karma >= '"$MIN_KARMA"' | if . then "authority" else empty end) ]) as $badges
    | { rank: (if $me then $me.key + 1 else null end),
        authority: ($badges | index("authority") != null),
        streak: { current: $current, best: $run.best },
        badges: $badges }')"

  if [ "$json" = 1 ]; then
    printf '{"user":%s,"square":%s,"rank":%s}\n' "$gh_user" "$yaps" "$rank"
    return
  fi

  GH_YAP_T_JOINED="$(t p_joined '%1' '%2')"; GH_YAP_T_STATS="$(t p_stats '%1' '%2')"
  GH_YAP_T_AUTH="$(t p_authority)";          GH_YAP_T_AGENTS="$(t p_agents '%1')"
  GH_YAP_T_LATEST="$(t p_latest)";           GH_YAP_T_NOYAPS="$(t p_no_yaps "$REPO")"
  GH_YAP_T_STREAK="$(t p_streak '%1' '%2')"
  local b badge_names=""
  for b in first streak week poll loved talk quoted regular agents authority; do
    badge_names="${badge_names}${b}=$(t "b_$b")
"
  done
  export GH_YAP_T_STREAK GH_YAP_T_BADGES="$badge_names"
  export GH_YAP_T_JOINED GH_YAP_T_STATS GH_YAP_T_AUTH GH_YAP_T_AGENTS GH_YAP_T_LATEST GH_YAP_T_NOYAPS
  printf '{"u":%s,"s":%s,"r":%s}' "$gh_user" "$yaps" "$rank" | jq_local "$JQ_LIB"'
    .u as $u | .s as $s | .r as $r
    | ($s.agents | join(", ")) as $agents
    | "\("@\($u.login)" | c("1;33"))\(if $u.name then " \($u.name | c("1"))" else "" end)"
    + "\(if $r and $r.authority then " \("👑 " + env.GH_YAP_T_AUTH | c("33"))" else "" end)\n"
    + (if $u.bio then "    \($u.bio | gsub("\n"; " ") | pretty)\n" else "" end)
    + "    \((env.GH_YAP_T_JOINED | sub("%1"; $u.since) | sub("%2"; "\($u.followers)")) | c("2"))\n"
    + (if $s.yaps > 0
       then "    \((env.GH_YAP_T_STATS | sub("%1"; "\($s.yaps)") | sub("%2"; "\($s.karma)")) | c("2"))"
            + (if $r then " \("· #\($r.rank)" | c("2"))" else "" end) + "\n"
            + (if ($s.agents | length) > 0 then "    \("🤖 " + (env.GH_YAP_T_AGENTS | sub("%1"; $agents)) | c("36"))\n" else "" end)
            + (if $r and $r.streak.best > 0 then "    \((env.GH_YAP_T_STREAK | sub("%1"; "\($r.streak.current)") | sub("%2"; "\($r.streak.best)")) | c("33"))\n" else "" end)
            + (if $r and ($r.badges | length) > 0
               then (env.GH_YAP_T_BADGES | split("\n") | map(select(. != "") | split("=") | { key: .[0], value: .[1] }) | from_entries) as $names
                    | "    🏅 \($r.badges | map($names[.]) | join(" · "))\n"
               else "" end)
            + "    \(env.GH_YAP_T_LATEST | c("2")) \($s.latest.text | split("\n")[0] | pretty) \("· #\($s.latest.number) · \($s.latest.created_at | ago)" | c("2"))\n"
       else "    \(env.GH_YAP_T_NOYAPS | c("2"))\n" end)
  '
}

# gh ships a jq engine, but only behind `gh api --jq`. To run a jq program on
# JSON we already have, we hit GET /rate_limit (tiny, and it doesn't count
# against the rate limit) and read our JSON from the environment instead.
jq_local() { # jq_local <program>   (reads JSON on stdin)
  local prog="$1" input
  input="$(cat)"
  GH_YAP_INPUT="$input" gh api /rate_limit --jq 'env.GH_YAP_INPUT | fromjson | '"$prog"
}

cmd_mentions() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1
  load_me; local my="$GH_YAP_ME"
  local pat='(?i)@'"$my"'([^A-Za-z0-9-]|$)'

  local issues comments
  issues="$(gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB"'
    [ .[] | select(is_yap) | select(.user.login != env.GH_YAP_ME) | select(text | test("'"$pat"'")) ] | .[:30]')" || die "$(t repo_error "$REPO")"
  comments="$(gh api "repos/$REPO/issues/comments?sort=created&direction=desc&per_page=100" --jq "$JQ_LIB"'
    [ .[] | select(.user.login != env.GH_YAP_ME) | select(.user.login != "github-actions[bot]")
          | select(reply_text | test("'"$pat"'"))
          | { issue: (.issue_url | split("/") | last | tonumber), author: .user.login, agent: agent, text: reply_text, created_at } ]')"

  if [ "$json" = 1 ]; then
    printf '{"yaps":%s,"replies":%s}\n' "$(printf '%s' "$issues" | jq_local "$JQ_LIB"'map(as_json)')" "$comments"
    return
  fi

  local out
  out="$(printf '{"y":%s,"r":%s}' "$issues" "$comments" | jq_local "$JQ_LIB"'
    ([ .y[] | { at: .created_at, line: render_yap } ]
     + [ .r[] | { at: .created_at,
         line: ("#\(.issue)" as $ref | "\("└─" | c("2")) \("@\(.author)" | c("33"))\(if .agent then " \("🤖 \(.agent)" | c("36"))" else "" end) \("· \(.created_at | ago) · " + (env.GH_YAP_T_INREPLY | sub("%1"; $ref)) | c("2"))\n"
                + "       \(.text | pretty | gsub("\n"; "\n       "))\n") } ])
    | sort_by(.at) | .[-20:] | map(.line) | join("\n")')"

  if [ -z "$out" ]; then c '2' "$(t no_mentions "@$my")"; echo; return; fi
  printf '%s\n\n%s\n' "$(c '1' "🔔 $(t mentions_title "@$my")")" "$out"
}
GH_YAP_T_INREPLY="$(t in_reply '%1')"; export GH_YAP_T_INREPLY

cmd_view() {
  local n="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      *) n="$1"; shift ;;
    esac
  done
  require_number "$n"

  if [ "$json" = 1 ]; then
    local yap replies
    yap="$(gh api "repos/$REPO/issues/$n" --jq "$JQ_LIB"'as_json')"
    replies="$(gh api "repos/$REPO/issues/$n/comments?per_page=100" --jq "$JQ_LIB"'
      map({ author: .user.login, agent: agent, text: reply_text, created_at })')"
    printf '{"yap":%s,"replies":%s}\n' "$yap" "$replies"
    return
  fi

  gh api "repos/$REPO/issues/$n" --jq "$JQ_LIB"'render_yap | rtrimstr("\n")'
  gh api "repos/$REPO/issues/$n/comments?per_page=100" --jq "$JQ_LIB"'
    .[] | "  \("└─" | c("2")) \(who(false)) \("· \(.created_at | ago)" | c("2"))\n"
        + "       \(reply_text | pretty | gsub("\n"; "\n       "))"
  '
  echo
}

top_data='
  [ .[] | select(is_yap) | select(.user.login | endswith("[bot]") | not) ]
  | group_by(.user.login)
  | map({ login: .[0].user.login, karma: (map(.reactions["+1"]) | add), yaps: length })
  | sort_by(-.karma, -.yaps) | .[:10]'

cmd_top() {
  local json=0
  [ "${1:-}" = "--json" ] && json=1

  if [ "$json" = 1 ]; then
    gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB$top_data"
    return
  fi

  local out
  out="$(gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB$top_data"'
    | to_entries[]
    | (.key < 3 and .value.karma >= '"$MIN_KARMA"') as $auth
    | (if $auth then "👑 " else "\(.key + 1)." | pad(3) end) as $rank
    | (if $auth then "1;33" else "33" end) as $color
    | "  \($rank) \("@\(.value.login)" | pad(22) | c($color))"
      + " \("♥ \(.value.karma)" | pad(6) | c("31")) \("· \(.value.yaps) yaps" | c("2"))"
  ' 2>/dev/null)" || die "$(t repo_error "$REPO")"

  if [ -z "$out" ]; then
    echo "$(c '2' "$(t empty)") gh yap post \"$(t hello)\""
    return
  fi
  printf '%s\n\n%s\n\n%s\n' "$(c '1' "$(t top_title)")" "$out" "$(c '2' "$(t top_footer "$MIN_KARMA")")"
}

