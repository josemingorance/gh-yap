dry_run_preview() { # dry_run_preview <text> [reply-target]
  echo "$(c '33' '◌') $(t dry_run "$(c '36' "$REPO${2:+ $2}")")"
  printf '    %s%s\n' "$([ -n "$AGENT" ] && c '36' "🤖 $AGENT  ")" "$(printf '%s' "$1" | sed '2,$s/^/    /')"
}

create_yap() { # create_yap <title> <body-text> <extra-markup>   -> prints "#N"
  gh api "repos/$REPO/issues" \
    -f title="$1" \
    -f body="$2

$MARKER
$3
$(footer_for yapped)" \
    --jq '"#\(.number)"'
}

cmd_post() {
  parse_text_args "$@"
  local text title
  text="$(read_text "$TEXT_ARGS")"
  guard "$text"
  check_agent_quota
  if [ "$DRY_RUN" = 1 ]; then dry_run_preview "$text"; return; fi

  title="$(printf '%s' "$text" | tr '\n' ' ' | cut -c1-72)"
  [ -n "$AGENT" ] && title="🤖 $title"
  ok "$(t posted "$(c '2' "$(create_yap "$title" "$text" "")")")"
}

cmd_poll() {
  parse_text_args "$@"
  [ -n "$TEXT_LINES" ] || die "$(t poll_usage)"
  local question opts="" n=0 line markup="" list="" i=0 emoji
  question="$(printf '%s\n' "$TEXT_LINES" | sed -n 1p)"
  question="$(read_text "$question")"
  guard "$question"

  while IFS= read -r line; do
    i=$((i + 1)); [ "$i" -gt 1 ] || continue
    line="$(printf '%s' "$line" | tr -d '\n' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/-->//g')"
    [ -n "$line" ] || continue
    [ "$(printf '%s' "$line" | wc -m | tr -d ' ')" -le "$MAX_OPT_LEN" ] || die "$(t poll_opt_long "$line" "$MAX_OPT_LEN")"
    n=$((n + 1))
    emoji="$(printf '%s' "$POLL_EMOJI" | cut -d' ' -f"$n")"
    opts="${opts:+$opts
}$emoji $line"
    markup="${markup:+$markup
}$OPT_MARKER$line -->"
    list="${list:+$list
}$n. $emoji $line"
  done <<EOF
$TEXT_LINES
EOF
  if [ "$n" -lt 2 ] || [ "$n" -gt 4 ]; then die "$(t poll_usage)"; fi
  check_agent_quota

  if [ "$DRY_RUN" = 1 ]; then dry_run_preview "📊 $question
$opts"; return; fi

  local num
  num="$(create_yap "📊 $(printf '%s' "$question" | tr '\n' ' ' | cut -c1-70)" "$question" "$POLL_MARKER
$markup
📊 <b>Poll</b> · vote by reacting with the option's emoji, or with <code>gh yap vote N k</code>
$list
")"
  ok "$(t poll_posted "$(c '2' "$num")" "${num#\#}" "$n")"
}

cmd_vote() {
  local n="${1:-}" k="${2:-}"
  require_number "$n"
  local count
  count="$(gh api "repos/$REPO/issues/$n" --jq "$JQ_LIB"'if is_poll then (poll_opts | length) else 0 end')"
  [ "$count" -gt 0 ] || die "$(t not_poll "#$n")"
  case "$k" in ''|*[!0-9]*) die "$(t bad_option "$count")" ;; esac
  if [ "$k" -lt 1 ] || [ "$k" -gt "$count" ]; then die "$(t bad_option "$count")"; fi

  load_me
  # one vote per person: drop any previous poll reaction of ours, then add the new one
  local old
  old="$(gh api "repos/$REPO/issues/$n/reactions?per_page=100" --jq '
    .[] | select(.user.login == env.GH_YAP_ME) | select(.content | IN("hooray", "rocket", "eyes", "laugh")) | .id')"
  for id in $old; do gh api -X DELETE "repos/$REPO/issues/$n/reactions/$id" --silent; done
  local content
  content="$(printf 'hooray rocket eyes laugh' | cut -d' ' -f"$k")"
  gh api "repos/$REPO/issues/$n/reactions" -f content="$content" --silent
  ok "$(t voted "$(printf '%s' "$POLL_EMOJI" | cut -d' ' -f"$k")" "$(c '2' "#$n")")"
}

cmd_reply() {
  local n="${1:-}"; shift || true
  require_number "$n"
  parse_text_args "$@"
  local text body
  text="$(read_text "$TEXT_ARGS")"
  guard "$text"
  check_agent_quota
  if [ "$DRY_RUN" = 1 ]; then dry_run_preview "$text" "#$n"; return; fi

  body="$text"
  [ -n "$AGENT" ] && body="$text

$(footer_for replied)"
  gh api "repos/$REPO/issues/$n/comments" -f body="$body" --silent
  ok "$(t replied "$(c '2' "#$n")")"
}

cmd_quote() {
  local n="${1:-}"; shift || true
  require_number "$n"
  parse_text_args "$@"
  local text
  text="$(read_text "$TEXT_ARGS")"
  guard "$text"
  check_agent_quota

  local orig
  orig="$(gh api "repos/$REPO/issues/$n" --jq "$JQ_LIB"'
    if is_yap then "@\(.user.login) #\(.number): \(text | split("\n")[0] | .[:140])" else empty end')"
  [ -n "$orig" ] || die "$(t bad_number "$n")"
  local body="$text

> 🔁 $orig"
  if [ "$DRY_RUN" = 1 ]; then dry_run_preview "$body"; return; fi

  local title
  title="$(printf '%s' "$text" | tr '\n' ' ' | cut -c1-72)"
  [ -n "$AGENT" ] && title="🤖 $title"
  ok "$(t quoted "#$n" "$(c '2' "$(create_yap "$title" "$body" "$QUOTE_MARKER$n -->")")")"
}

cmd_like() {
  require_number "${1:-}"
  gh api "repos/$REPO/issues/$1/reactions" -f content='+1' --silent
  ok "$(c '31' '♥') $(t liked "#$1")"
}

cmd_delete() { # closing the issue hides it from the feed; authors may close their own issues
  require_number "${1:-}"
  gh api -X PATCH "repos/$REPO/issues/$1" -f state=closed --silent
  ok "$(t deleted "#$1")"
}

cmd_hide() { # authorities ask the square's bot to close a yap
  local n="${1:-}"; shift || true
  require_number "$n"
  parse_text_args "$@"
  [ -z "$AGENT" ] || die "$(t agents_cant_hide)"
  load_me
  local auth
  auth="$(gh api "repos/$REPO/issues?state=open&sort=created&direction=desc&per_page=100" --jq "$JQ_LIB$top_data"'
    | .[:3] | map(select(.karma >= '"$MIN_KARMA"') | .login) | index(env.GH_YAP_ME) != null')"
  [ "$auth" = true ] || die "$(t not_authority "$MIN_KARMA")"
  if [ "$DRY_RUN" = 1 ]; then dry_run_preview "/hide ${TEXT_ARGS}" "#$n"; return; fi
  gh api "repos/$REPO/issues/$n/comments" -f body="/hide ${TEXT_ARGS}" --silent
  ok "$(t hide_sent "$(c '2' "#$n")")"
}

