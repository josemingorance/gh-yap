cmd_tui() { # the full-screen interface lives in its own precompiled extension
  if gh extension list 2>/dev/null | grep -q 'josemingorance/gh-yap-tui'; then
    GH_YAP_REPO="$REPO" exec gh yap-tui "$@"
  fi
  die "$(t tui_missing "$(c '36' 'gh extension install josemingorance/gh-yap-tui')")"
}

cmd_dm() { # encrypted DMs are implemented in the Go extension (it does the crypto)
  local arg
  for arg in "$@"; do case "$arg" in --agent|--agent=*) die "$(t dm_agent)" ;; esac; done
  [ -z "${GH_YAP_AGENT:-}" ] || die "$(t dm_agent)"
  if gh extension list 2>/dev/null | grep -q 'josemingorance/gh-yap-tui'; then
    exec gh yap-tui dm "$@"
  fi
  die "$(t dm_missing "$(c '36' 'gh extension install josemingorance/gh-yap-tui')")"
}

cmd_open() {
  if [ -n "${1:-}" ]; then
    require_number "$1"
    gh browse "$1" --repo "$REPO"
  else
    gh issue list --web --repo "$REPO"
  fi
}

cmd_whoami() {
  load_me
  t whoami "$(c '1;33' "@$GH_YAP_ME")" "$(c '36' "$REPO")"
  echo
  if [ -n "$AGENT" ]; then
    t whoami_agent "$(c '36' "🤖 $AGENT")"
    echo
  fi
}

