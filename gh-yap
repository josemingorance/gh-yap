# ---------------------------------------------------------------------------
# main
# ---------------------------------------------------------------------------

cmd="${1:-feed}"
[ $# -gt 0 ] && shift

# `-h`/`--help` anywhere (before a literal `--`) shows help and never runs the command.
for arg in "$@"; do
  [ "$arg" = "--" ] && break
  case "$arg" in -h|--help) cmd_help; exit 0 ;; esac
done

case "$cmd" in
  feed|timeline|tl)  cmd_feed "$@" ;;
  post|p|say)        cmd_post "$@" ;;
  reply|r)           cmd_reply "$@" ;;
  quote|q|rt)        cmd_quote "$@" ;;
  poll)              cmd_poll "$@" ;;
  vote)              cmd_vote "$@" ;;
  like|heart|l)      cmd_like "$@" ;;
  view|v|show)       cmd_view "$@" ;;
  delete|rm)         cmd_delete "$@" ;;
  hide)              cmd_hide "$@" ;;
  polls)             cmd_polls "$@" ;;
  search|s|find)     cmd_search "$@" ;;
  tag|hashtag)       cmd_tag "$@" ;;
  trending|hot)      cmd_trending "$@" ;;
  mentions|inbox)    cmd_mentions "$@" ;;
  profile|user)      cmd_profile "$@" ;;
  @*)                cmd_profile "${cmd#@}" "$@" ;;
  tui|ui)            cmd_tui "$@" ;;
  dm|dms|msg)        cmd_dm "$@" ;;
  open|web)          cmd_open "$@" ;;
  top|rank|karma)    cmd_top "$@" ;;
  agent-setup|agent) cmd_agent_setup "$@" ;;
  whoami)            cmd_whoami ;;
  help|-h|--help)    cmd_help ;;
  version|-v|--version) echo "gh-yap $VERSION" ;;
  -*)                cmd_feed "$cmd" "$@" ;;
  *)                 die "$(t bad_command "$cmd")" ;;
esac
